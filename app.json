{
  "expo": {
    "name": "ClawVoice",
    "slug": "third-voice-ai",
    "version": "3.0.0",
    "description": "ClawVoice, formerly Iclawd, lets you control OpenClaw agents by voice from CarPlay.",
    "keywords": [
      "iclawd",
      "openclaw",
      "carplay",
      "watch",
      "voice",
      "agent",
      "handsfree"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "iclawd",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#060c18"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rakhimzhan.ai.third.voice",
      "buildNumber": "14",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ClawVoice needs microphone access for voice conversations with your OpenClaw agent.",
        "NSSpeechRecognitionUsageDescription": "ClawVoice uses speech recognition to convert your voice to text.",
        "NSCameraUsageDescription": "ClawVoice uses the camera to scan QR codes for gateway connection.",
        "NSPhotoLibraryUsageDescription": "ClawVoice may access your photo library to share images with your AI agent.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.rakhimzhan.ai.third.voice",
      "versionCode": 204,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#060c18"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "3e46a0eb-c2c5-4191-bd9e-c356c499f4e5"
      }
    },
    "owner": "rassul.rakhimzhan",
    "runtimeVersion": "3.0.0",
    "updates": {
      "url": "https://u.expo.dev/3e46a0eb-c2c5-4191-bd9e-c356c499f4e5",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/with-optional-firebase",
      "./plugins/with-carplay",
      "./plugins/with-watchos",
      "@config-plugins/react-native-siri-shortcut",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "backgroundColor": "#060c18"
        }
      ]
    ]
  }
}
